[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5

# DOCKER-USER chain is called from FORWARD before Docker's own rules.
# Standard INPUT chain rules are bypassed by Docker's NAT/FORWARD path —
# bans there are invisible to container-bound traffic.
banaction          = iptables-allports[chain=DOCKER-USER]
banaction_allports = iptables-allports[chain=DOCKER-USER]

# Trusted IPs / CIDRs that are never banned.
# 127.0.0.1/8 and ::1 are always implied by fail2ban.
# Add your own in .env as WHITELIST_CIDRS="192.168.1.0/24 10.0.0.1"
# (space or comma separated — must also match WAF WHITELIST_CIDRS)
# 172.16.0.0/12   — Docker bridge networks (containers never banned)
# 66.133.109.0/23 — Let's Encrypt / ISRG validation servers (cert renewal must not be blocked)
ignoreip = 127.0.0.1/8 ::1 172.16.0.0/12 66.133.109.0/23

[sshd]
enabled  = true
port     = ssh
logpath  = /host-logs/auth.log
maxretry = 3
bantime  = 24h
# SSH is host-bound, not Docker — keep it on INPUT
action   = iptables-allports[chain=INPUT]

[npm-http-auth]
enabled      = true
filter       = npm-http-auth
logpath      = /npm_data/logs/proxy-host-*_access.log
               /npm_data/logs/default-host_access.log
               /npm_data/logs/fallback_http_access.log
               /dev/null
maxretry     = 10
findtime     = 5m
bantime      = 30m

[npm-badbots]
enabled      = true
filter       = npm-badbots
logpath      = /npm_data/logs/proxy-host-*_access.log
               /npm_data/logs/default-host_access.log
               /dev/null
maxretry     = 1
findtime     = 1m
bantime      = -1

[npm-404]
enabled      = true
filter       = npm-404
logpath      = /npm_data/logs/proxy-host-*_access.log
               /npm_data/logs/default-host_access.log
               /npm_data/logs/fallback_http_access.log
               /dev/null
maxretry     = 10
findtime     = 2m
bantime      = 1h

[dashboard-login]
enabled  = true
filter   = auth-login
logpath  = /auth_data/auth.log
maxretry = 5
findtime = 10m
bantime  = 1h

[geoblock]
enabled  = true
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[chain=DOCKER-USER]
bantime  = -1
maxretry = 1
findtime = 1d

[manual-ban]
enabled  = true
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[chain=DOCKER-USER]
bantime  = -1
maxretry = 1
findtime = 1d
