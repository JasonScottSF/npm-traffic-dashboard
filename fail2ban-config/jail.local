[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
banaction = iptables-multiport

[sshd]
enabled  = true
port     = ssh
logpath  = /host-logs/auth.log
maxretry = 3
bantime  = 24h

[npm-http-auth]
enabled  = true
port     = http,https
filter   = npm-http-auth
logpath  = /npm_logs/proxy-host-*_access.log
           /npm_logs/default-host_access.log
           /npm_logs/fallback_http_access.log
maxretry = 10
findtime = 5m
bantime  = 30m

[npm-badbots]
enabled  = true
port     = http,https
filter   = npm-badbots
logpath  = /npm_logs/proxy-host-*_access.log
           /npm_logs/default-host_access.log
maxretry = 2
findtime = 1m
bantime  = 24h

[npm-404]
enabled  = true
port     = http,https
filter   = npm-404
logpath  = /npm_logs/proxy-host-*_access.log
           /npm_logs/default-host_access.log
           /npm_logs/fallback_http_access.log
maxretry = 10
findtime = 2m
bantime  = 1h

[dashboard-login]
enabled  = true
filter   = auth-login
logpath  = /auth_data/auth.log
maxretry = 5
findtime = 10m
bantime  = 1h
action   = iptables-allports[name=dashboard-login, protocol=all]

[geoblock]
enabled  = false
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[name=geoblock, protocol=all]
bantime  = -1
maxretry = 1
findtime = 1d

[manual-ban]
enabled  = true
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[name=manual-ban, protocol=all]
bantime  = -1
maxretry = 1
findtime = 1d
