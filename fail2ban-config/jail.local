[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
banaction = iptables-multiport

# Trusted IPs / CIDRs that are never banned.
# 127.0.0.1/8 and ::1 are always implied by fail2ban.
# Add your own in .env as WHITELIST_CIDRS="192.168.1.0/24 10.0.0.1"
# (space or comma separated — must also match WAF WHITELIST_CIDRS)
ignoreip = 127.0.0.1/8 ::1 172.16.0.0/12 %(ENV[WHITELIST_CIDRS])s

[sshd]
enabled  = true
port     = ssh
logpath  = /host-logs/auth.log
maxretry = 3
bantime  = 24h

[npm-http-auth]
enabled  = true
port     = http,https
filter   = npm-http-auth
logpath  = /npm_data/logs/proxy-host-*_access.log
           /npm_data/logs/default-host_access.log
           /npm_data/logs/fallback_http_access.log
maxretry = 10
findtime = 5m
bantime  = 30m

[npm-badbots]
enabled  = true
port     = http,https
filter   = npm-badbots
logpath  = /npm_data/logs/proxy-host-*_access.log
           /npm_data/logs/default-host_access.log
maxretry = 1
findtime = 1m
bantime  = -1

[npm-404]
enabled  = true
port     = http,https
filter   = npm-404
logpath  = /npm_data/logs/proxy-host-*_access.log
           /npm_data/logs/default-host_access.log
           /npm_data/logs/fallback_http_access.log
maxretry = 10
findtime = 2m
bantime  = 1h

[dashboard-login]
enabled  = true
filter   = auth-login
logpath  = /auth_data/auth.log
maxretry = 5
findtime = 10m
bantime  = 1h
action   = iptables-allports[name=dashboard-login, protocol=all]

[geoblock]
enabled  = false
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[name=geoblock, protocol=all]
bantime  = -1
maxretry = 1
findtime = 1d

[manual-ban]
enabled  = true
filter   = geoblock
logpath  = /dev/null
backend  = polling
action   = iptables-allports[name=manual-ban, protocol=all]
bantime  = -1
maxretry = 1
findtime = 1d
