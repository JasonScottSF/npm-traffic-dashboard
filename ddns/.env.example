# NPM admin credentials — used to discover proxy host domains
NPM_URL=http://your-server-ip:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# Route53
DDNS_HOSTED_ZONE_ID=Z3IKZ3F0ZCKPBK
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How often to check (seconds)
DDNS_INTERVAL=300

# DNS record TTL (seconds)
DDNS_TTL=60
