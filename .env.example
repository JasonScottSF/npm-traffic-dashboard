# ── Non-secret configuration ─────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# Secrets (passwords, tokens, API keys) are NO LONGER stored here.
# See secrets/README.txt for how to create the required secret files.

# Port the dashboard is served on (direct access, bypassing NPM)
DASHBOARD_PORT=8090

# Dashboard app name shown on the login page
APP_NAME=NPM Dashboard

# Session cookie security — controls the `Secure` flag on the session cookie.
#
# Leave this commented out (the default). The auth service automatically sets
# the Secure flag when a request arrives over HTTPS (NPM sets X-Forwarded-Proto=https
# when it terminates TLS) and omits it for plain HTTP connections. This means
# HTTPS external domains and HTTP internal/LAN domains both work without any
# manual configuration.
#
# Set to `true` ONLY if you want to hard-force Secure cookies on ALL connections
# regardless of protocol (e.g. every domain has TLS and you want belt-and-suspenders).
# Set to `true` with a plain HTTP domain and the browser will silently drop the
# session cookie — you will be stuck in a login redirect loop that looks like
# your credentials are wrong.
#
# COOKIE_SECURE=true

# Timezone for fail2ban (e.g. America/Los_Angeles, UTC, Europe/London)
TZ=America/Los_Angeles

# ── Backup ────────────────────────────────────────────────────────────────────
# How often to back up (seconds, default 3600 = 60 min)
BACKUP_INTERVAL=3600
# Secret: BACKUP_GITHUB_TOKEN → secrets/backup_github_token.txt

# ── Whitelist ─────────────────────────────────────────────────────────────────
# Space or comma separated CIDRs exempt from both fail2ban and the WAF.
# 127.0.0.1/8, ::1, and the Docker bridge (172.16.0.0/12) are always exempt.
# Example: WHITELIST_CIDRS=192.168.1.0/24 10.0.0.1
WHITELIST_CIDRS=

# ── WAF ───────────────────────────────────────────────────────────────────────
# DetectionOnly = log attacks but don't block (safe default, review events first)
# On            = actively block matched requests (403)
# Off           = disable ModSecurity entirely
WAF_MODE=DetectionOnly

# ── SMTP (required for forgot-password emails) ────────────────────────────────
# Public URL of the dashboard — used to build reset links in emails
# Example: https://dash.yourdomain.com
APP_URL=

# SMTP server host and port. Port 587 = STARTTLS (default), 465 = SSL.
SMTP_HOST=
SMTP_PORT=587
# From address shown in the reset email (defaults to SMTP_USER secret if blank)
SMTP_FROM=
# Secrets: SMTP_USER → secrets/smtp_user.txt
#          SMTP_PASSWORD → secrets/smtp_password.txt

# How long a self-service reset link stays valid (seconds, default 3600 = 1 h)
RESET_EXP=3600

# How long a session token stays valid (seconds, default 28800 = 8 h)
TOKEN_EXP=28800

# How long an invite link stays valid (seconds, default 172800 = 48 h)
INVITE_EXP=172800

# ── Landing page ─────────────────────────────────────────────────────────────
# Direct access port for the landing page (default 8091)
LANDING_PORT=8091

# NPM admin credentials — used by the landing page to auto-sync proxy hosts.
# Leave blank to disable NPM sync (manual hosts only).
NPM_API_URL=http://nginx_proxy_manager:81
NPM_API_EMAIL=
NPM_API_PASSWORD=

# How often to sync hosts from NPM and re-check status (seconds, default 60)
LANDING_SYNC_INTERVAL=60

# ── Data retention ────────────────────────────────────────────────────────────
# How many days of traffic records the API keeps (default 90)
RETENTION_DAYS=90

# How many days of parser state the log parser keeps (default 90)
STATE_RETENTION_DAYS=90

# ── Secrets (moved to secrets/*.txt) ─────────────────────────────────────────
# The following values are NO LONGER read from .env. Create the corresponding
# file in the secrets/ directory instead (see secrets/README.txt):
#
#   secrets/db_password.txt          — PostgreSQL dashboard user password
#   secrets/backup_github_token.txt  — GitHub PAT for backup repo
#   secrets/smtp_user.txt            — SMTP login / from address
#   secrets/smtp_password.txt        — SMTP password
#   secrets/abuseipdb_key.txt        — AbuseIPDB API key
#   secrets/maxmind_license_key.txt  — MaxMind GeoLite2 license key
