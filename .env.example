# Copy this to .env and fill in values
DB_PASSWORD=changeme_secure_password

# Optional: MaxMind license key for GeoIP country lookups
# Get a free key at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Port to expose the dashboard on
DASHBOARD_PORT=8080

# Dashboard app name (shown on login page)
APP_NAME=NPM Dashboard

# Set to false ONLY for local HTTP testing (no HTTPS).
# Keep true when the dashboard is behind a reverse proxy with TLS.
COOKIE_SECURE=true

# Timezone for the fail2ban server container
TZ=America/Los_Angeles

# REQUIRED if using the blocklist service — IPs/CIDRs that must never be blocked.
# Add your home IP, office range, VPN, and any management networks.
# Comma or space separated. RFC1918 ranges are always safe automatically.
# Example: WHITELIST_CIDRS=203.0.113.50,198.51.100.0/24
WHITELIST_CIDRS=

# How often to refresh the threat IP blocklist (hours, default 24)
BLOCKLIST_REFRESH_HOURS=24
